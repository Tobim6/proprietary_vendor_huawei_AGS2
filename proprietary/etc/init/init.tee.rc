on init
#mount secure storage partition for teeos
    #mkdir /sec_storage
     mount ext4 /dev/block/bootdevice/by-name/secure_storage /sec_storage nosuid nodev noatime wait crypt discard,auto_da_alloc,mblk_io_submit,data=journal,context=u:object_r:teecd_data_file:s0
     chown root root /sec_storage
     chmod 600 /sec_storage

on init
#add for TrustedCore driver
    chmod 0400 /dev/hisi_teelog

#secure os tee agent
# The keymaster HAL (class early_hal, started at late-fs) talks to the TEE through libteec, which connects to
# system_teecd/teecd ("connect ca daemon failed with system_teecd" otherwise). They therefore have to start in
# the same early stage, not in class core (started much later): with the TEE keymaster module a clean boot hung
# for ever because the HAL could not open its TEE context and init waits for the HAL.
service system_teecd /system/bin/system_teecd
    socket tui_daemon stream 660 root system
    socket tee-multi-user stream 660 root system
    class early_hal
    user root
    group root readproc

service teecd /vendor/bin/teecd
    class early_hal
    user root
    group root readproc
    seclabel u:r:tee:s0


service teelogcat /system/bin/sh -c "rm -f /cache/boot_teelog.txt; /vendor/bin/tlogcat -f > /cache/boot_teelog.txt 2>&1"
    class core
    user root
    group root system

# set sec_storage_data can be access by teecd
on fs
    mkdir /data/sec_storage_data 0700 system system
    restorecon /data/sec_storage_data
    mkdir /data/sec_storage_data_users 0700 system system
    restorecon /data/sec_storage_data_users

on post-fs-data
   mkdir /data/vendor/log/sec_storage_data 0775 system system
   mkdir /data/vendor/log/sec_storage_data/log 0755 system system

# keymaster-3-0 is "disabled" in its own rc and started here, right after class_start early_hal has started the
# TEE daemons above (this action is parsed after init.rc's late-fs action).
on late-fs
    start keymaster-3-0

# android.hardware.keymaster@3.0-impl.so (EMUI8-sourced, replacing the
# HMOS2.0-generation TEE stack) needs libkeymaster1.so -- a genuine EMUI8
# /system partition file (AOSP's legacy keymaster1 module wrapper, needed
# for libsoftkeymasterdevice's fallback path), never on vendor at all.
# system.img hasn't been rebuilt this session, so this alone won't reach
# the device without a live push -- see device tree README/memory.
include $(CLEAR_VARS)
LOCAL_MODULE := libkeymaster1_emui8
LOCAL_MODULE_STEM := libkeymaster1
LOCAL_MODULE_OWNER := huawei
LOCAL_PROPRIETARY_MODULE := true
LOCAL_SRC_FILES_64 := proprietary/lib64/libkeymaster1.so
LOCAL_SRC_FILES_32 := proprietary/lib/libkeymaster1.so
LOCAL_MULTILIB := both
LOCAL_MODULE_TAGS := optional
LOCAL_MODULE_CLASS := SHARED_LIBRARIES
LOCAL_MODULE_SUFFIX := .so
include $(BUILD_PREBUILT)

# /system/bin/system_teecd -- EMUI8's real CA (client authentication) daemon
# for libteec.so's "connect ca daemon" handshake. init.tee.rc's "system_teecd"
# service execs this; without it, every TEE client (gatekeeper, keymaster,
# teecd itself) fails with "connect ca daemon failed with system_teecd" ->
# "Initialize TEE context failed". Genuinely a /system file in stock EMUI8
# (confirmed via its own file_contexts: system_teecd_exec), not vendor --
# same system.img-not-rebuilt caveat as libkeymaster1 above.
include $(CLEAR_VARS)
LOCAL_MODULE := system_teecd
LOCAL_MODULE_OWNER := huawei
LOCAL_SRC_FILES := system_teecd_extract/system_teecd
LOCAL_MODULE_TAGS := optional
LOCAL_MODULE_CLASS := EXECUTABLES
include $(BUILD_PREBUILT)

